# Application
APP_NAME=rag-foundation
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# HTTP / ingestion limits
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_FILE_SIZE_MB=25

# Groq LLM
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# Hugging Face embeddings
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16

# Chunking
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=20
CHUNK_MAX_SIZE=2000
SEMANTIC_SIMILARITY_THRESHOLD=0.72

# Retrieval
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=

# Query transformation
QUERY_TRANSFORMATION_ENABLED=true
# QUERY_TRANSFORMATION_MAX_TOKENS=256

# Multi-query retrieval
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3
# MULTI_QUERY_MAX_TOKENS=512

# Hybrid search
HYBRID_SEARCH_ENABLED=true
VECTOR_SEARCH_WEIGHT=0.5
KEYWORD_SEARCH_WEIGHT=0.5
HYBRID_TOP_K=10
# KEYWORD_INDEX_PATH=keyword_index/index.json

# Context optimization
CONTEXT_OPTIMIZATION_ENABLED=true
CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_TOKENS=6000
CONTEXT_MIN_SCORE=0.0

# Upload limits
# MAX_BATCH_UPLOAD_FILES=20

# LLM generation
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Qdrant
# Local dev: http://localhost:6333
# Docker Compose overrides this to http://qdrant:6333
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents
QDRANT_TIMEOUT_SECONDS=10

# Docker runtime paths (Compose sets KEYWORD_INDEX_PATH inside the app container)
# KEYWORD_INDEX_PATH=keyword_index/index.json
