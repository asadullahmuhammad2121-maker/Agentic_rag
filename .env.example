# =============================================================================
# Application
# =============================================================================
APP_NAME=rag-foundation
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# =============================================================================
# HTTP / server
# =============================================================================
# Request timeout enforced by middleware (seconds)
REQUEST_TIMEOUT_SECONDS=120
# Local Docker Compose fallback when Railway PORT is not set
APP_PORT=8000
# Uvicorn worker processes per container (use 1 when scaling containers horizontally)
UVICORN_WORKERS=1
UVICORN_TIMEOUT_KEEP_ALIVE=5

# Railway: do not set PORT manually — Railway injects it at runtime for each service.

# =============================================================================
# Upload limits
# =============================================================================
MAX_UPLOAD_FILE_SIZE_MB=25
# MAX_BATCH_UPLOAD_FILES=20

# =============================================================================
# Groq LLM
# =============================================================================
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# =============================================================================
# Hugging Face embeddings
# =============================================================================
HUGGINGFACE_API_KEY=
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGINGFACE_TIMEOUT_SECONDS=60
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16

# =============================================================================
# Chunking
# =============================================================================
CHUNKING_STRATEGY=fixed
CHUNK_SIZE=500
CHUNK_OVERLAP=50
CHUNK_MIN_SIZE=20
CHUNK_MAX_SIZE=2000
SEMANTIC_SIMILARITY_THRESHOLD=0.72

# =============================================================================
# Retrieval
# =============================================================================
RETRIEVAL_TOP_K=5
# RETRIEVAL_SCORE_THRESHOLD=

# Query transformation
QUERY_TRANSFORMATION_ENABLED=true
# QUERY_TRANSFORMATION_MAX_TOKENS=256

# Multi-query retrieval
MULTI_QUERY_ENABLED=true
MULTI_QUERY_COUNT=3
# MULTI_QUERY_MAX_TOKENS=512

# Hybrid search
HYBRID_SEARCH_ENABLED=true
VECTOR_SEARCH_WEIGHT=0.5
KEYWORD_SEARCH_WEIGHT=0.5
HYBRID_TOP_K=10
# Local dev path (Compose overrides inside the app container)
# KEYWORD_INDEX_PATH=keyword_index/index.json
KEYWORD_INDEX_LOCK_TIMEOUT_SECONDS=30

# Context optimization
CONTEXT_OPTIMIZATION_ENABLED=true
CONTEXT_MAX_CHUNKS=8
CONTEXT_MAX_TOKENS=6000
CONTEXT_MIN_SCORE=0.0

# =============================================================================
# LLM generation
# =============================================================================
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# =============================================================================
# Agent (Phase 3A–3F)
# =============================================================================
AGENT_MAX_STEPS=2
AGENT_ROUTING_ENABLED=true
# AGENT_ROUTING_MAX_TOKENS=256
AGENT_PLANNING_ENABLED=true
# AGENT_PLANNING_MAX_TOKENS=512

# =============================================================================
# Tavily web search (Phase 3D)
# =============================================================================
# WEB_SEARCH_ENABLED is an alias for TAVILY_ENABLED
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT_SECONDS=30

# =============================================================================
# Calculator (Phase 3G)
# =============================================================================
CALCULATOR_ENABLED=true
# CALCULATOR_MAX_EXPRESSION_LENGTH=500

# =============================================================================
# Qdrant
# =============================================================================
# Local dev: http://localhost:6333
# Docker Compose: http://qdrant:6333
# Railway: http://<qdrant-service>.railway.internal:6333 (private networking)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=documents
QDRANT_TIMEOUT_SECONDS=10

# =============================================================================
# Production (Railway / Docker Compose deploy)
# =============================================================================
# Copy these values into Railway service variables (never commit real secrets):
#
# APP_ENV=production
# GROQ_API_KEY=
# HUGGINGFACE_API_KEY=
# TAVILY_API_KEY=
# WEB_SEARCH_ENABLED=true
# HYBRID_SEARCH_ENABLED=true
# VECTOR_SEARCH_WEIGHT=0.5
# KEYWORD_SEARCH_WEIGHT=0.5
# HYBRID_TOP_K=10
# UVICORN_WORKERS=1
# QDRANT_URL=http://<qdrant-private-host>:6333
# KEYWORD_INDEX_PATH=/app/data/keyword_index/index.json
#
# Frontend build args (set at deploy/build time, not runtime secrets):
# NEXT_PUBLIC_API_URL=/backend
# API_URL=http://<gateway-private-host>:<gateway-port>
#
# Gateway service variable:
# BACKEND_UPSTREAM=<backend-private-host>:<backend-port>

# =============================================================================
# Docker Compose notes
# =============================================================================
# - Secrets stay in .env on the host; they are injected at runtime, not baked
#   into the image.
# - Compose sets QDRANT_URL, KEYWORD_INDEX_PATH, APP_PORT, and BACKEND_UPSTREAM.
# - Scale API replicas with:
#     docker compose up --build --scale app=3
# - Access the load-balanced API through the gateway (default port 8080):
#     GATEWAY_PORT=8080 docker compose up --build --scale app=3
